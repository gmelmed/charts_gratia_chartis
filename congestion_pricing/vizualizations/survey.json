{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/gmelmed/charts_gratia_chartis/refs/heads/main/congestion_pricing/data/processed/survey_data.csv"
  },
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "Borough",
      "type": "nominal",
      "sort": ["Overall", "Manhattan", "Brooklyn", "Queens", "Bronx", "Staten Island"]
    },
    "x": {
      "field": "percentage",
      "type": "quantitative",
      "stack": "normalize"
    },
    "color": {
      "field": "response",
      "type": "nominal",
      "scale": {
        "scheme": "purpleorange",
        "domain": [
          "Strongly support",
          "Somewhat support",
          "Neutral or no opinion",
          "Somewhat oppose",
          "Strongly oppose"
        ]
      },
      "legend": {
        "orient": "top"
      }
    },
    "tooltip": [
      {"field": "Borough", "type": "nominal"},
      {"field": "response", "type": "nominal", "title": "Response"},
      {"field": "percentage", "type": "quantitative", "format": ".1%", "title": "Percentage"}
    ]
  },
  "title":{
    "text": "New Yorkers were split on congestion pricing after its introduction.",
    "subtitle": [
      "Data from a Third Avenue Institute poll of NYC registered voters from Jan 13th-31st, 2025 (n=264).",
      ""
      ]
  },
  "width": 600,
  "height": 400,
  "config": {
    "font": "Biennale, sans-serif",
    "view": {"stroke": "transparent"},
    "background": "#f7f7f7",
    "range": {"category": {"scheme": "observable10"}},
    "axis": {
      "labelColor": "#676A86",
      "labelFontSize": 11,
      "labelFont": "Biennale, sans-serif",
      "labelOpacity": 0.7,
      "tickColor": "#676A86",
      "tickOpacity": 0.5,
      "domainColor": "#676A86",
      "domainOpacity": 0.5,
      "gridColor": "#676A86",
      "gridDash": [2, 2],
      "gridOpacity": 0.5,
      "title": null,
      "titleColor": "#676A86",
      "titleOpacity": 0.8,
      "tickSize": 4
    },
    "axisXQuantitative": {
      "grid": false,
      "tickCount": 5
      },
    "title": {
      "font": "Lexend, sans-serif",
      "fontSize": 20,
      "color": "#1a1a1a",
      "subtitleFontSize": 16,
      "subtitleColor": "#676A86",
      "anchor":"start"
    },
    "header": {
      "labelFontSize": 12,
      "labelFont": "Lexend, sans-serif"
    },
    "legend": {
      "title": null
    }
  }
}