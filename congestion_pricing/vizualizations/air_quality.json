{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/gmelmed/charts_gratia_chartis/refs/heads/main/congestion_pricing/data/processed/air_quality_nyc_daily.csv"
  },
  "transform": [
    {"filter": "toDate(datum.date) >= toDate('2024-09-01')"},
    {"filter": "datum.measure === 'daily_low_90d_ma' || datum.measure === 'daily_high_90d_ma'"},
    {"filter": "datum.site_name != 'Hamilton Bridge (Bronx)'"},
    {"pivot": "measure", "value": "concentration", "groupby": ["date", "site_name"]}
  ],
  "columns": 2,
  "facet": {
    "field": "site_name",
    "type": "nominal",
    "title": null
  },
  "spec": {
    "width": 350,
    "height": 250,
    "layer": [
      {
        "transform": [{"fold": ["daily_high_90d_ma", "daily_low_90d_ma"], "as": ["measure", "concentration"]}],
        "encoding": {
          "x": {
            "field": "date",
            "type": "temporal",
            "axis": {
              "format": "%Y",
              "tickCount": "year"
            }
          },
          "y": {
            "field": "concentration",
            "type": "quantitative",
            "scale": {"type": "linear", "zero": false},
            "title": null,
            "axis": {"format": "~s"}
          },
          "color": {
            "field": "measure",
            "type": "nominal",
            "scale": {
              "domain": ["daily_high_90d_ma", "daily_low_90d_ma"],
              "range": ["#4269d0", "#efb118"]
            },
            "legend": {
              "title": null,
              "orient": "top",
              "labelExpr": "datum.value === 'daily_high_90d_ma' ? 'Daily High' : 'Daily Low'"
            }
          },
          "tooltip": [
            {
              "field": "date",
              "type": "temporal",
              "format": "%B %d, %Y",
              "title": "Date"
            },
            {
              "field": "daily_high_90d_ma",
              "type": "quantitative",
              "format": ",.1f",
              "title": "Daily High (µg/m³)"
            },
            {
              "field": "daily_low_90d_ma",
              "type": "quantitative",
              "format": ",.1f",
              "title": "Daily Low (µg/m³)"
            }
          ]
        },
        "layer": [
          {"mark": {"type": "line"}},
          {
            "transform": [{"filter": {"param": "hover", "empty": false}}],
            "mark": {
              "type": "point",
              "filled": true,
              "size": 60
            }
          }
        ]
      },
      {
        "mark": "rule",
        "encoding": {
          "x": {"field": "date", "type": "temporal"},
          "opacity": {
            "condition": {"value": 0.3, "param": "hover", "empty": false},
            "value": 0
          },
          "tooltip": [
            {
              "field": "date",
              "type": "temporal",
              "format": "%B %d, %Y",
              "title": "Date"
            },
            {
              "field": "daily_high_90d_ma",
              "type": "quantitative",
              "format": ",.1f",
              "title": "Daily High (µg/m³)"
            },
            {
              "field": "daily_low_90d_ma",
              "type": "quantitative",
              "format": ",.1f",
              "title": "Daily Low (µg/m³)"
            }
          ]
        },
        "params": [
          {
            "name": "hover",
            "select": {
              "type": "point",
              "fields": ["date"],
              "nearest": true,
              "on": "pointerover",
              "clear": "pointerout"
            }
          }
        ]
      },
      {
        "mark": {
          "type": "rule",
          "color": "#676A86",
          "strokeWidth": 2,
          "strokeDash": [4, 4]
        },
        "encoding": {
          "x": {
            "datum": {"year": 2025, "month": 1, "date": 5}
          }
        }
      }
    ]
  },
  "resolve": {"scale": {"y": "independent"}},
  "title": {
    "text": "Air Quality has improved, but not evenly.",
    "subtitle": [
      "90-day average of daily high and low PM2.5 concentrations.",
      "Vertical line represents introduction of congestion pricing.",
      "Data: NYC Open Data.",
      ""
    ]
  },
  "config": {
    "font": "Biennale, sans-serif",
    "view": {"stroke": "transparent"},
    "background": "#f7f7f7",
    "range": {"category": {"scheme": "observable10"}},
    "axis": {
      "labelColor": "#676A86",
      "labelFontSize": 11,
      "labelFont": "Biennale, sans-serif",
      "labelOpacity": 0.7,
      "tickColor": "#676A86",
      "tickOpacity": 0.5,
      "domainColor": "#676A86",
      "domainOpacity": 0.5,
      "gridColor": "#676A86",
      "gridDash": [2, 2],
      "gridOpacity": 0.5,
      "title": null,
      "titleColor": "#676A86",
      "titleOpacity": 0.8,
      "tickSize": 4
    },
    "axisXTemporal": {"grid": false},
    "axisYQuantitative": {
      "gridColor": "#676A86",
      "gridDash": [1, 5],
      "gridOpacity": 0.5,
      "ticks": false,
      "labelPadding": 5,
      "tickCount": 4,
      "titleAngle": 0,
      "titleAlign": "left",
      "titleBaseline": "bottom",
      "titleX": 0,
      "titleY": -5
    },
    "title": {
      "font": "Lexend, sans-serif",
      "fontSize": 20,
      "color": "#1a1a1a",
      "subtitleFontSize": 16,
      "subtitleColor": "#676A86"
    },
    "header": {
      "labelFontSize": 12,
      "labelFont": "Lexend, sans-serif"
    }
  }
}